#!/usr/bin/env python3
"""overlay-status - report on a user's overlays.

usage:
  overlay-status OVERLAY_DIR

For each overlay in OVERLAY_DIR, prints the number of items under
"## Pending flush", and reports overlays whose module doesn't exist in this
repository and overlays that lack the two sections of the overlay template
in TEMPLATE.md ("## Local facts" and "## Pending flush"). The last line is
the total of pending items. Lines inside fenced code blocks are ignored.

Exit status is 1 when an overlay names no existing module, 2 on usage
errors, 0 otherwise.
"""

import os
import re
import sys

NAME_RE = re.compile(r'^[a-z0-9]+(?:-[a-z0-9]+)*\.md$')
SECTIONS = ['## Local facts', '## Pending flush']


def module_names(top):
    """Module names under the area directories of this repository."""
    names = set()
    for area in os.listdir(top):
        path = os.path.join(top, area)
        if area.startswith('.') or area == 'tools' or not os.path.isdir(path):
            continue
        names |= {f[:-3] for f in os.listdir(path) if NAME_RE.match(f)}
    return names


def main():
    args = sys.argv[1:]
    if args and args[0] in ('-h', '--help'):
        print(__doc__)
        return 0
    if len(args) != 1:
        sys.stderr.write('usage: overlay-status OVERLAY_DIR\n')
        return 2
    odir = os.path.expanduser(args[0])
    if not os.path.isdir(odir):
        sys.stderr.write(f'overlay-status: {odir}: no such directory\n')
        return 2

    top = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
    modules = module_names(top)
    if not modules:
        sys.stderr.write(f'overlay-status: no modules found under {top}\n')
        return 2

    orphans, total = 0, 0
    for name in sorted(os.listdir(odir)):
        if not name.endswith('.md'):
            continue
        with open(os.path.join(odir, name), encoding='utf-8', errors='replace') as f:
            lines = [l.rstrip() for l in f.read().splitlines()]
        prose, fence = [], None
        for line in lines:
            s = line.lstrip()
            if fence:
                if s.startswith(fence):
                    fence = None
            elif s.startswith(('```', '~~~')):
                fence = s[:3]
            else:
                prose.append(line)
        notes = []
        if name[:-3] not in modules:
            notes.append('no such module')
            orphans += 1
        missing = [s for s in SECTIONS if s not in prose]
        if missing:
            notes.append('missing ' + ', '.join(f'"{s[3:]}"' for s in missing))
        pending, inside = 0, False
        for line in prose:
            if line.startswith('## '):
                inside = line == '## Pending flush'
            elif inside and line.startswith('- '):
                pending += 1
        total += pending
        print(f'{name[:-3]:28} {pending:3} pending' +
              (f'  ({"; ".join(notes)})' if notes else ''))
    print(f'{"total":28} {total:3} pending')
    return 1 if orphans else 0


if __name__ == '__main__':
    sys.exit(main())
